# Maintainer: Chymaera Linux Contributors
#
# Local-dev/ISO-build package for the Chymaera Code Agent. Builds directly
# from whatever commit the packages/agent submodule is checked out to, so
# advancing the agent is just:
#   git submodule update --remote packages/agent && git add packages/agent
# followed by a rebuild — no tagged release or published tarball required.
#
# The AUR/release-oriented package (built from a tagged GitHub release
# tarball instead of a local checkout) is maintained upstream at
# packages/agent/packaging/arch/PKGBUILD and is the source of truth for the
# systemd unit, sysusers snippet, and env template installed below — this
# file only adapts *how the source is fetched*, not what gets installed.

_agent_src="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../agent" && pwd)"

pkgname=chymaera-code-agent-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="Local-first Python reimplementation of the Claude Code agent architecture (built from the local packages/agent submodule checkout)"
arch=('any')
url="https://github.com/chymaera3301/Chymaera_Code_Agent"
license=('unknown')
depends=('python' 'python-fastapi' 'python-uvicorn' 'python-pydantic')
optdepends=(
  'python-psutil: system memory/CPU/GPU telemetry for the Claude Code escalation trigger'
  'claude-code: hand off tasks to the real Claude Code CLI when local resources are insufficient'
)
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools' 'git')
provides=('chymaera-code-agent')
conflicts=('chymaera-code-agent')
source=("chymaera-code-agent::git+file://${_agent_src}")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/chymaera-code-agent"
  printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/chymaera-code-agent"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/chymaera-code-agent"

  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 packaging/arch/chymaera-code-service.service \
    "$pkgdir/usr/lib/systemd/system/chymaera-code-service.service"
  install -Dm644 packaging/arch/chymaera-code.sysusers \
    "$pkgdir/usr/lib/sysusers.d/chymaera-code.conf"
  install -Dm644 packaging/arch/service.env.example \
    "$pkgdir/etc/chymaera-code/service.env.example"
  install -Dm644 README.md \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
}
